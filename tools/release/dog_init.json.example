{
  "poll_interval_seconds": 5,
  "net_class_path": "/sys/class/net",
  "ignored_interfaces": ["lo"],
  "require_usb_device_path": true,
  "interface_name_patterns": ["^usb[0-9]+$", "^rndis[0-9]+$", "^enx[0-9A-Fa-f]{12}$"],
  "driver_names": ["rndis_host", "cdc_ether", "cdc_ncm", "ipheth"],
  "ping_count": 3,
  "ping_timeout_seconds": 1,
  "gateway_fail_threshold": 3,
  "nmcli_timeout_seconds": 40,
  "nmcli_state_timeout_seconds": 2,
  "ip_timeout_seconds": 10,
  "usb_ip_settle_seconds": 15,
  "usb_ip_settle_interval_seconds": 0.5,
  "sudo_password": "REPLACE_LOCALLY_OR_USE_SUDOERS",
  "wired_connection_name": "Wired connection 5",
  "static_address_last_octet": 200,
  "dog_app_config_path": "/opt/orange-demo/current/dog/config.example.json",
  "http_server_host": "0.0.0.0",
  "http_server_port": 18892,
  "dog_services_script_path": "/opt/orange-demo/current/dog/start_dog_services.sh",
  "dog_services_process_pattern": "",
  "dog_services_pid_dir": "/opt/orange-demo/current/dog/.dog-services/pids",
  "dog_services_run_user": "",
  "dog_services_log_path": "/tmp/start_dog_services.log",
  "dog_services_start_verify_delay_seconds": 1,
  "log_level": "INFO"
}
