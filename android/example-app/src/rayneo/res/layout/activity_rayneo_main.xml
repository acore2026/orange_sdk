<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical"
    android:paddingStart="30dp"
    android:paddingTop="20dp"
    android:paddingEnd="30dp"
    android:paddingBottom="20dp">

    <TextView
        android:id="@+id/deployment_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans"
        android:letterSpacing="0.08"
        android:text="RAYNEO X3 PRO  ·  AGENT A"
        android:textColor="#5EEAD4"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/status_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="sans"
        android:text="正在准备端侧链路"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/status_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans"
        android:maxLines="2"
        android:text="Runtime 101.245.78.174:8088  ·  MASQUE/UDP 8443"
        android:textColor="#B7CBD4"
        android:textSize="16sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="14dp"
        android:background="#29404A" />

    <ScrollView
        android:id="@+id/log_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <TextView
            android:id="@+id/log_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:lineSpacingMultiplier="1.15"
            android:text="应用启动中…"
            android:textColor="#C9D9DF"
            android:textSize="16sp" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/primary_action"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/rayneo_action_primary"
            android:focusable="true"
            android:fontFamily="sans"
            android:gravity="center"
            android:text="自动启动中…"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="14dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/stop_action"
            android:layout_width="170dp"
            android:layout_height="match_parent"
            android:background="@drawable/rayneo_action_secondary"
            android:focusable="true"
            android:fontFamily="sans"
            android:gravity="center"
            android:text="停止 / 退出"
            android:textColor="#D7E5EA"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/gesture_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="sans"
        android:gravity="center"
        android:text="前后 / 上下滑动切换焦点  ·  单击确认  ·  双击退出"
        android:textColor="#8FA9B4"
        android:textSize="16sp" />

</LinearLayout>
