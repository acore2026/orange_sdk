<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#06090D"
    android:keepScreenOn="true">

    <FrameLayout
        android:id="@+id/video_preview_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000">

        <com.rayneo.agent.example.TextureViewEglRenderer
            android:id="@+id/video_renderer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/video_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/rayneo_top_prompt"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/status_title"
            android:letterSpacing="0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="NEXT · VOICE COMMAND"
            android:textColor="#E9FCFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Try saying: Send the robot dog to patrol."
            android:textColor="#B5D8E5"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/patrol_hud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="42dp"
        android:layout_marginEnd="42dp"
        android:background="@drawable/rayneo_middle_prompt"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp">

        <TextView
            android:id="@+id/patrol_phase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Awaiting task"
            android:textColor="#E9FCFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/patrol_candidate"
            android:ellipsize="end"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:maxLines="3"
            android:text="Preparing digital identity"
            android:textColor="#B5D8E5"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/patrol_alert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="#79E7CA"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/rayneo_voice_input"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/patrol_command_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="26dp"
            android:text="Voice recognition"
            android:textColor="#E9FCFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/voice_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Awaiting voice command"
            android:textColor="#B5D8E5"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Both eyes show the same warning; it does not take voice control focus. -->
    <LinearLayout
        android:id="@+id/expel_warning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="42dp"
        android:layout_marginEnd="42dp"
        android:background="@drawable/rayneo_expel_warning"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        android:accessibilityLiveRegion="assertive"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="WARNING · DANGEROUS ACTION"
            android:textColor="#FFCB75"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Expel: robot lunges forward. Keep people clear."
            android:textColor="#FFF0DC"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Second confirmation required"
            android:textColor="#FFF0DC"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Please say Confirm to proceed"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Say Cancel to dismiss · Expires after 30 seconds"
            android:textColor="#FFCB75"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView android:id="@+id/deployment_label" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/asr_action" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/voice_control_action" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/patrol_confirm_action" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/patrol_reject_action" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/patrol_threaten_action" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/patrol_evict_action" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/primary_action" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/reset_action" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/dump_action" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/stop_action" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/gesture_hint" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <ScrollView android:id="@+id/log_scroll" android:layout_width="wrap_content" android:layout_height="wrap_content">
            <TextView android:id="@+id/log_output" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>
