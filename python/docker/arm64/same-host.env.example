# Image imported with: docker load -i agent-connect-sdk-0.17.5-linux-arm64.tar.gz
AGENT_IMAGE=agent-connect-sdk:0.17.5-arm64

# Dedicated outer/access network. Change the entire subnet if it overlaps an
# existing host or Docker network.
AGENT_ACCESS_NETWORK=agent-sdk-access
AGENT_ACCESS_SUBNET=172.29.100.0/24
AGENT_ACCESS_GATEWAY=172.29.100.1
AGENT_A_CONTAINER_IP=172.29.100.2
AGENT_B_CONTAINER_IP=172.29.100.3

# Agent A uses the first Runtime and CONNECT-IP endpoint published on the host.
AGENT_A_RUNTIME_IP=172.29.100.1
AGENT_A_RUNTIME_PORT=8088
AGENT_A_MASQUE_URL=https://172.29.100.1:8443/.well-known/masque/ip
AGENT_A_MASQUE_TOKEN=

# Agent B uses the second Runtime and CONNECT-IP endpoint published on the host.
AGENT_B_RUNTIME_IP=172.29.100.1
AGENT_B_RUNTIME_PORT=8089
AGENT_B_MASQUE_URL=https://172.29.100.1:8444/.well-known/masque/ip
AGENT_B_MASQUE_TOKEN=

AGENT_TUN_MTU=1280
AGENT_TARGET_CAPABILITY=video_rendering
AGENT_CAPABILITY=video_rendering

# Agent A creates the formal computing session and verifies this many processed
# frames before releasing it. Set 0 to keep receiving until interrupted.
AGENT_COMPUTE_CAPABILITY_ID=video_rendering
AGENT_COMPUTE_CPU_MILLICORES=2000
AGENT_COMPUTE_MEMORY_MIB=4096
AGENT_COMPUTE_TIMEOUT=30
AGENT_COMPUTE_TERMINAL_ACTION=release
AGENT_MEDIA_TIMEOUT=30
AGENT_PROCESSED_FRAME_COUNT=1
AGENT_PROCESSED_FRAME_TIMEOUT=30

# Agent B loops the synthetic MP4 packaged in the repository and exits after
# C-05 closes this many sessions. Set AGENT_MAX_SESSIONS=0 to keep serving.
AGENT_VIDEO_SOURCE=file
AGENT_VIDEO_FILE=/opt/agent-sdk/examples/assets/video-offload-test.mp4
AGENT_LOOP_VIDEO=true
AGENT_VIDEO_WIDTH=1280
AGENT_VIDEO_HEIGHT=720
AGENT_VIDEO_FPS=30
AGENT_VIDEO_BITRATE_KBPS=2500
AGENT_SESSION_CLOSE_TIMEOUT=60
AGENT_MAX_SESSIONS=1

# The ARM image is intended for repeatable integration tests: never reuse a
# persisted identity/Card, and remove the newly registered identity on exit.
# Set this to true to discard local Profile/Card state without first
# deregistering the previous network identity. It takes precedence over
# AGENT_FRESH_REGISTRATION.
AGENT_FORCE_REGISTRATION=false
AGENT_FRESH_REGISTRATION=true
AGENT_DEREGISTER_ON_EXIT=true
