# Image imported with: docker load -i agent-connect-sdk-0.17.5-linux-arm64.tar.gz
AGENT_IMAGE=agent-connect-sdk:0.17.5-arm64

# Dedicated outer/access network. Change the entire subnet if it overlaps an
# existing host or Docker network.
AGENT_ACCESS_NETWORK=agent-sdk-access
AGENT_ACCESS_SUBNET=172.29.100.0/24
AGENT_ACCESS_GATEWAY=172.29.100.1
AGENT_A_CONTAINER_IP=172.29.100.2
AGENT_B_CONTAINER_IP=172.29.100.3

# Agent A uses the first Runtime and CONNECT-IP endpoint published on the host.
AGENT_A_RUNTIME_IP=172.29.100.1
AGENT_A_RUNTIME_PORT=8088
AGENT_A_MASQUE_URL=https://172.29.100.1:8443/.well-known/masque/ip
AGENT_A_MASQUE_TOKEN=

# Agent B uses the second Runtime and CONNECT-IP endpoint published on the host.
AGENT_B_RUNTIME_IP=172.29.100.1
AGENT_B_RUNTIME_PORT=8089
AGENT_B_MASQUE_URL=https://172.29.100.1:8444/.well-known/masque/ip
AGENT_B_MASQUE_TOKEN=

AGENT_TUN_MTU=1280
AGENT_TARGET_CAPABILITY=text
AGENT_CAPABILITY=text

# The ARM image is intended for repeatable integration tests: never reuse a
# persisted identity/Card, and remove the newly registered identity on exit.
AGENT_FRESH_REGISTRATION=true
AGENT_DEREGISTER_ON_EXIT=true
